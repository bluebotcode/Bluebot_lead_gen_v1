# Copy this file to .env and fill in real values.

# Required: Google Cloud project with the Places API enabled and billing set up.
GOOGLE_PLACES_API_KEY=

# Required in any deployed/public instance: HTTP Basic Auth credentials that
# gate the entire app (UI + API). Every search spends real Google Places API
# budget - without these set, the app runs with NO ACCESS GATE (a startup
# warning is logged). Pick a real shared password, not the example below.
LEADS_BASIC_AUTH_USER=bluebot
LEADS_BASIC_AUTH_PASSWORD=change-me

# Optional: port the server listens on (defaults to 3000). Most hosts
# (including SiteGround's Node.js App Manager) set this automatically.
PORT=3000
